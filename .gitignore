node_modules/
node_modules
coverage/
*.log
.DS_Store
# .flow runtime state — project-specific local state, not source.
# The plugin recreates these directories at runtime in any target repo.
.flow/
__pycache__/
*.pyc

# BMad tooling and the PRD/design docs — kept locally, not published.
_bmad/
_bmad-output/
# Exception: the BMad adapter's test fixtures contain a fake `_bmad-output/`
# tree (committed test data, not local planning artefacts).
!plugins/flow/mcp-server/src/adapters/bmad/fixtures/**/_bmad-output/
!plugins/flow/mcp-server/src/adapters/bmad/fixtures/**/_bmad-output/**
.claude/skills/bmad-*/

# Track implementation-artifacts only: the story specs double as the BMad
# parser's regression corpus (parse-bmad-story-corpus integration test).
# planning-artifacts (PRD, epics, architecture) stays local-only.
!_bmad-output/
_bmad-output/*
!_bmad-output/implementation-artifacts/
!_bmad-output/implementation-artifacts/**

# Claude Code runtime — generated per-session/per-machine, not source
.claude/scheduled_tasks.lock
.claude/*.lock
.claude/settings.local.json
.claude/*.local.json
.worktrees/
.claude/worktrees/
.claude/workflows/

# Local-only operating notes (private working context, not source)
internal/
# Exception: the run workflow scripts live in plugins/flow/workflows/internal/ and are tracked.
!plugins/flow/workflows/internal/
