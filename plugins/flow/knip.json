{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignoreBinaries": ["python3"],
  "ignoreExportsUsedInFile": false,
  "workspaces": {
    ".": {
      "entry": ["workflows/*.js"],
      "project": ["workflows/*.js"]
    },
    "mcp-server": {
      "entry": ["src/cli.ts", "scripts/*.mjs"],
      "project": ["src/**/*.ts"]
    }
  }
}
